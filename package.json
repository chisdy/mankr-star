{
  "name": "mankr-star",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:shared": "pnpm --filter @mankr/shared test",
    "test:worker": "pnpm --filter web test",
    "deploy": "pnpm --filter web exec wrangler deploy",
    "db:generate": "pnpm --filter @mankr/db generate",
    "db:migrate:local": "pnpm --filter web db:migrate:local",
    "db:seed:local": "bash packages/db/seed/reset-and-seed.sh"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "~7.0.2"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  }
}
