{
  "manifest_version": 3,
  "name": "Mankr Star",
  "version": "0.2.0",
  "description": "浏览时标出已经收藏到 Mankr Star 的网页。",
  "permissions": ["tabs", "storage", "alarms"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Mankr Star",
    "default_popup": "popup.html"
  }
}
